# OCI credentials (place the private key at ~/.oci/oci_api_key.pem with mode 600)
OCI_USER_OCID=ocid1.user.oc1..<change-me>
OCI_TENANCY_OCID=ocid1.tenancy.oc1..<change-me>
OCI_FINGERPRINT=aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99
OCI_REGION=us-sanjose-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..<change-me>

# AgentMail
AGENTMAIL_API_KEY=<change-me>
AGENTMAIL_INBOX_USERNAME=hypercube

# Alerts / operations
BUDGET_ALERT_EMAIL=ops@example.com

# Optional: Tailscale auth key for VM
# TAILSCALE_AUTH_KEY=tskey-auth-...

# Optional: allow paid OCI shapes (human must set explicitly)
# ALLOW_PAID=true
